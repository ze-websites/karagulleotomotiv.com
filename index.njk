          <div class="cards">
            <article class="card">
              <div class="media card-img">
                <img
                  src="assets/img/hizmetler/genis-urun-yelpazesi.jpg"
                  alt="Raflarda yedek parçalar"
                  loading="lazy"
                  decoding="async"
                  onerror="this.remove()"
                />
              </div>
              <div class="icon">
                <svg viewBox="0 0 24 24">
                  <path d="M3 7l9-4 9 4-9 4-9-4z" />
                  <path d="M3 12l9 4 9-4" />
                  <path d="M3 17l9 4 9-4" />
                </svg>
              </div>
              <h3>Geniş Ürün Yelpazesi</h3>
              <p>
                Farklı marka ve modeller için birçok yedek parça grubunu tek bir
                tedarikçiden sağlıyoruz.
              </p>
            </article>
            <article class="card">
              <div class="media card-img">
                <img
                  src="assets/img/hizmetler/orjinal-ve-muadil.jpg"
                  alt="Fren diski ve balata"
                  loading="lazy"
                  decoding="async"
                  onerror="this.remove()"
                />
