            fetchpriority="high"
            decoding="async"
            onerror="this.remove()"
          /><img
            class="s2"
            src="assets/img/slider-2.jpg"
            alt=""
            loading="lazy"
            decoding="async"
            onerror="this.remove()"
          /><img
            class="s3"
            src="assets/img/slider-3.jpg"
            alt=""
            loading="lazy"
            decoding="async"
            onerror="this.remove()"
          />
