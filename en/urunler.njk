---
layout: page-layout.njk
title: Product List
description: Browse Karagulle Automotive product groups.
assetBase: "../../"
language: en
bodyClass: product-list-page english-page
permalink: en/product/
---
<section class="product-catalog">
  <div class="catalog-wrap">
    <div class="catalog-intro"><div><div class="product-eyebrow">Our products</div><h1>Product <span>List</span></h1><p>Choose a product group and contact us for availability, fitment and pricing.</p></div><a class="catalog-back" href="../../en/">← Back to home</a></div>
    <div class="catalog-toolbar"><div class="catalog-filters"><button class="filter-button active" data-filter="all">All</button><button class="filter-button" data-filter="motor">Engine</button><button class="filter-button" data-filter="aktarma">Drivetrain</button><button class="filter-button" data-filter="sasi">Chassis</button><button class="filter-button" data-filter="kaporta">Body</button>{% for group in productGroups %}{% if group.slug != 'motor' and group.slug != 'aktarma' and group.slug != 'sasi' and group.slug != 'kaporta' %}<button class="filter-button" data-filter="{{ group.slug }}">{{ group.name_en }}</button>{% endif %}{% endfor %}</div><label class="catalog-search"><span class="sr-only">Search products</span><input id="product-search" type="search" placeholder="Search products..." /></label></div>
    <div class="catalog-grid" id="product-grid">
      {% for product in collections.products %}<article class="catalog-card cms-product" data-category="{{ product.data.category }}" data-name="{{ (product.data.title_en ~ ' ' ~ ((product.data.keywords | default([], true)) | join(' '))) | lower }}" onclick="if (!event.target.closest('a')) window.location.href='../product/{{ product.data.title_en | slug }}/'" style="cursor:pointer">{% if product.data.image %}<img class="product-image" src="../../{{ product.data.image }}" alt="{{ product.data.title_en }}" loading="lazy" />{% else %}<div class="product-placeholder"><span>{{ product.data.title_en }}</span><small>PRODUCT IMAGE</small></div>{% endif %}<div class="catalog-card-body"><span class="catalog-category">{% for group in productGroups %}{% if group.slug == product.data.category %}{{ group.name_en }}{% endif %}{% endfor %}</span><h2>{{ product.data.title_en }}</h2><p>{{ product.data.description_en }}</p><a href="../../#iletisim">Request a quote</a></div></article>{% endfor %}
      <article class="catalog-card" data-category="sasi" data-name="underbody suspension"><div class="product-placeholder"><span>UNDERBODY</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Chassis</span><h2>Underbody &amp; Suspension</h2><p>Reliable parts for chassis and suspension systems.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="aktarma" data-name="transmission gear"><div class="product-placeholder"><span>TRANSMISSION</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Drivetrain</span><h2>Transmission &amp; Gears</h2><p>Durable solutions for different vehicle models.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="kaporta" data-name="body exterior"><div class="product-placeholder"><span>BODY PARTS</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Body</span><h2>Body Parts</h2><p>Exterior panels and replacement body parts.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="motor" data-name="engine complete motor"><div class="product-placeholder"><span>ENGINE</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Engine</span><h2>Complete Engine</h2><p>Engine solutions ready for your vehicle.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="aktarma" data-name="clutch"><div class="product-placeholder"><span>CLUTCH</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Drivetrain</span><h2>Clutch Set</h2><p>Smooth and dependable power transfer.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="motor" data-name="lubrication oil"><div class="product-placeholder"><span>LUBRICATION</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Engine</span><h2>Lubrication System</h2><p>Parts that support engine protection and performance.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="motor" data-name="alternator starter"><div class="product-placeholder"><span>STARTER</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Engine</span><h2>Starter &amp; Alternator</h2><p>Reliable electrical and starting system components.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="sasi" data-name="steering system"><div class="product-placeholder"><span>STEERING</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Chassis</span><h2>Steering System</h2><p>Strong components for safer and smoother driving.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="kaporta" data-name="hood fender panel"><div class="product-placeholder"><span>BODY PANELS</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Body</span><h2>Hoods &amp; Fenders</h2><p>Replacement panels for exterior body repairs.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="aktarma" data-name="gearbox differential"><div class="product-placeholder"><span>GEARS</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Drivetrain</span><h2>Gearbox Components</h2><p>Precision parts for dependable power transfer.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="motor" data-name="half engine"><div class="product-placeholder"><span>HALF ENGINE</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Engine</span><h2>Half Engine</h2><p>Complete solutions for engine renewal projects.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
      <article class="catalog-card" data-category="sasi" data-name="shock absorber suspension"><div class="product-placeholder"><span>SUSPENSION</span><small>PLACEHOLDER</small></div><div class="catalog-card-body"><span class="catalog-category">Chassis</span><h2>Shock Absorbers</h2><p>Durable suspension components for comfort and control.</p><a href="../../index.html#iletisim">Request a quote</a></div></article>
    </div>
  </div>
</section>
<script>
  const buttons = document.querySelectorAll(".filter-button"), cards = document.querySelectorAll(".catalog-card"), search = document.getElementById("product-search");
  const initialCategory = new URLSearchParams(window.location.search).get("kategori") || "all";
  const initialButton = document.querySelector(`[data-filter="${initialCategory}"]`);
  if (initialButton) { buttons.forEach((item) => item.classList.remove("active")); initialButton.classList.add("active"); }
  function filterProducts() { const category = document.querySelector(".filter-button.active").dataset.filter, query = search.value.toLowerCase().trim(); cards.forEach((card) => { card.hidden = !((category === "all" || card.dataset.category === category) && (!query || card.dataset.name.includes(query))); }); }
  filterProducts();
  buttons.forEach((button) => button.addEventListener("click", () => { buttons.forEach((item) => item.classList.remove("active")); button.classList.add("active"); filterProducts(); })); search.addEventListener("input", filterProducts);
</script>
